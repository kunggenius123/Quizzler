# Copy this file to .env and fill in your values.

# Required: OpenAI API key used by the Express server for table/notes parsing and MCQ generation
OPENAI_API_KEY=

# Optional: port for the Express API server (defaults to 5050)
PORT=5050

# Optional: URL of the Flask cell-extraction service (defaults to http://127.0.0.1:5051)
FLASK_URL=http://127.0.0.1:5051

# Optional (frontend): base URL of the Express API (defaults to http://127.0.0.1:5050)
VITE_API_URL=http://127.0.0.1:5050
